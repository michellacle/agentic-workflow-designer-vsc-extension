{
  "name": "vscode-workflow-designer",
  "displayName": "Agent Workflow Designer & Runtime",
  "description": "Visually design, execute, and debug workflows composed of VS Code custom agents",
  "version": "0.1.0",
  "publisher": "local-dev",
  "repository": "https://github.com/local-dev/agentic-workflows",
  "engines": {
    "vscode": "^1.129.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onCustomEditor:workflowDesigner.editor",
    "onChatParticipant:workflowDesigner.workflow"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Workflow Designer",
      "properties": {
        "workflowDesigner.animation.startNodeFlashMs": {
          "type": "number",
          "default": 3000,
          "minimum": 0,
          "description": "Duration in milliseconds for Start node in-progress flash animation."
        },
        "workflowDesigner.animation.edgeHandoffMs": {
          "type": "number",
          "default": 3000,
          "minimum": 0,
          "description": "Duration in milliseconds for edge handoff transition animation between nodes."
        },
        "workflowDesigner.animation.endNodeFlashMs": {
          "type": "number",
          "default": 1200,
          "minimum": 0,
          "description": "Duration in milliseconds for End node completion flash animation."
        },
        "workflowDesigner.animation.edgeDashSpeed": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Dash movement speed divisor for edge transition animation; lower values move faster."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "workflowDesigner.workflow",
        "name": "workflow",
        "fullName": "Workflow Designer",
        "description": "Run the current visual workflow with genuine GitHub Copilot subagents",
        "isSticky": true,
        "commands": [
          {
            "name": "run",
            "description": "Run the current visual workflow with genuine Copilot subagents"
          }
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "workflowDesigner.editor",
        "displayName": "Workflow Designer",
        "selector": [
          {
            "filenamePattern": "*.workflow.yaml"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "workflowDesigner.newWorkflow",
        "title": "New Workflow",
        "icon": {
          "light": "resources/light/new.svg",
          "dark": "resources/dark/new.svg"
        }
      },
      {
        "command": "workflowDesigner.addWorkflow",
        "title": "Add Workflow",
        "icon": {
          "light": "resources/light/add.svg",
          "dark": "resources/dark/add.svg"
        }
      },
      {
        "command": "workflowDesigner.runWorkflow",
        "title": "▶ Run Workflow with Copilot Subagents",
        "icon": {
          "light": "resources/light/play.svg",
          "dark": "resources/dark/play.svg"
        }
      },
      {
        "command": "workflowDesigner.pauseWorkflow",
        "title": "⏸ Pause Workflow",
        "icon": {
          "light": "resources/light/pause.svg",
          "dark": "resources/dark/pause.svg"
        }
      },
      {
        "command": "workflowDesigner.stopWorkflow",
        "title": "⏹ Stop Workflow",
        "icon": {
          "light": "resources/light/stop.svg",
          "dark": "resources/dark/stop.svg"
        }
      },
      {
        "command": "workflowDesigner.resumeWorkflow",
        "title": "🔄 Resume Workflow",
        "icon": {
          "light": "resources/light/resume.svg",
          "dark": "resources/dark/resume.svg"
        }
      },
      {
        "command": "workflowDesigner.saveWorkflow",
        "title": "💾 Save Workflow",
        "icon": {
          "light": "resources/light/save.svg",
          "dark": "resources/dark/save.svg"
        }
      },
      {
        "command": "workflowDesigner.validateWorkflow",
        "title": "✓ Validate Workflow",
        "icon": {
          "light": "resources/light/validate.svg",
          "dark": "resources/dark/validate.svg"
        }
      },
      {
        "command": "workflowDesigner.listModels",
        "title": "List Available Models"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "workflowDesigner.runWorkflow",
          "when": "customEditorId == 'workflowDesigner.editor'",
          "group": "navigation"
        },
        {
          "command": "workflowDesigner.pauseWorkflow",
          "when": "customEditorId == 'workflowDesigner.editor'",
          "group": "navigation"
        },
        {
          "command": "workflowDesigner.stopWorkflow",
          "when": "customEditorId == 'workflowDesigner.editor'",
          "group": "navigation"
        },
        {
          "command": "workflowDesigner.resumeWorkflow",
          "when": "customEditorId == 'workflowDesigner.editor'",
          "group": "navigation"
        },
        {
          "command": "workflowDesigner.saveWorkflow",
          "when": "customEditorId == 'workflowDesigner.editor'",
          "group": "navigation"
        },
        {
          "command": "workflowDesigner.validateWorkflow",
          "when": "customEditorId == 'workflowDesigner.editor'",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "workflowDesigner.addWorkflow",
          "when": "view == workflowExplorer.list",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workflowExplorer",
          "title": "Workflows",
          "icon": "resources/workflow-icon.svg"
        }
      ]
    },
    "views": {
      "workflowExplorer": [
        {
          "id": "workflowExplorer.list",
          "name": "Workflows"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "tsc -p ./ --sourceMap false",
    "lint": "eslint src --ext ts",
    "build-webview": "node scripts/build-webview.js",
    "dev": "npm run compile && npm run build-webview",
    "rebuild": "rm -rf out && npm run compile && npm run build-webview && npx vsce package --out vscode-workflow-designer-0.1.0.vsix 2>/dev/null && code --install-extension vscode-workflow-designer-0.1.0.vsix 2>/dev/null && echo '✅ Extension rebuilt and installed! Reload VS Code window to activate.'",
    "watch:webview": "node scripts/watch-webview.js",
    "dev:watch": "npm-run-all -p watch watch:webview",
    "test": "jest --forceExit"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^29.4.11",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "jest-environment-jsdom": "^30.4.1",
    "js-yaml": "^4.1.0",
    "jsdom": "^29.1.1"
  }
}
